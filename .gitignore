__pycache__/
*.pyc
*.egg-info/
.DS_Store

# Raw API caches from scripts/build_emissions_dataset.py (18 MB; rebuildable)
climate_risk_engine/data/training/raw/

# Backtest raw caches (rebuildable)
climate_risk_engine/data/backtest/raw/

# Runtime caches written by engine modules
climate_risk_engine/src/cri/.cache/

# Asset register download caches (rebuildable with scripts/build_asset_register.py)
climate_risk_engine/data/asset_register/raw/
# Risk Analyst build caches (rebuildable with scripts/build_finance_data.py)
climate_risk_engine/data/finance/raw/

# LCA build caches (rebuildable with scripts/build_lca_data.py)
climate_risk_engine/data/lca/raw/
# Runtime forecast/storm caches
climate_risk_engine/data/cache/forecast_*.json
climate_risk_engine/data/cache/nhc_current_storms.json
# Carbon factor build caches (rebuildable with scripts/build_carbon_factors.py)
climate_risk_engine/data/carbon/raw/

# Build output (rebuilt by `pip install` / `pip wheel`; a stale copy was once committed)
build/
dist/
.pytest_cache/
.hypothesis/

# Runtime state written by the watchlist agent into the working directory
climate_risk_engine/watchlist.json
climate_risk_engine/watchlist_scores.json
