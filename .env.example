# ── ClimRisk Engine — environment variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API key authentication ─────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the /v1/* endpoints.
# Leave empty to run without authentication (development only).
# Clients send:  X-API-Key: <key>
API_KEYS=changeme-dev-key-1,changeme-dev-key-2

# ── Supabase persistence ───────────────────────────────────────────────────────
# If both values are set, the engine persists the company registry to Supabase.
# If either is blank, the engine runs in-memory only (no data survives restarts).
#
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_secret_key>

# ── Anthropic AI (optional — used for NLP narrative generation endpoints) ──────
# Required only if you use the /narrative or /report endpoints.
ANTHROPIC_API_KEY=sk-ant-...

# ── Server settings (optional) ────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
